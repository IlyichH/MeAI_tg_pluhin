"""Auto-Me 2.0 - LLM-assisted message rewriter for exteraGram.

Single-file plugin (Python 3.11, Chaquopy). Provides .ai* command family,
multiple style profiles, confirm-before-send dialogs, in-memory LRU cache,
rate limiting, retry/backoff, statistics, import/export and Android-aware
clipboard helpers. All blocking work runs via run_on_queue; UI callbacks
are wrapped in try/except so the settings page survives plugin bugs.
"""

import hashlib
import json
import re
import threading
import time
import urllib.error
import urllib.request
from collections import OrderedDict
from datetime import datetime, timezone
from typing import Any, List

